# ReRoute configuration. Copy to .env - NEVER commit .env (it is git-ignored).

# ---- Mode -------------------------------------------------------------------
DEMO_MODE=true                 # deterministic seed + deterministic mock responses
# DEMO_SERVICE_DATE=2026-10-15 # pin the seeded schedule date (default: today, Asia/Seoul)
AGENT_STEP_DELAY_MS=350        # cosmetic pause per tool step so the live timeline is readable (0 = off)

# ---- NVIDIA (Real NVIDIA mode) ---------------------------------------------
# Get a key at https://build.nvidia.com  (starts with nvapi-)
NVIDIA_API_KEY=
LLM_PROVIDER=auto              # auto (Nemotron if NVIDIA_API_KEY is set) | nvidia | mock
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_ENABLE_THINKING=false

RETRIEVER_PROVIDER=lexical     # nvidia | lexical
NIM_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NIM_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NIM_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking

OPTIMIZATION_PROVIDER=fallback # cuopt | fallback
CUOPT_BASE_URL=http://cuopt:5000
OPTIMIZATION_ALLOW_FALLBACK=true
# CUOPT_IMAGE=nvidia/cuopt:latest-cu12

# ---- Security ---------------------------------------------------------------
SECURITY_RUNTIME=policy-mirror # openshell (agent runs inside an OpenShell sandbox) | policy-mirror
APPROVAL_SIGNING_SECRET=change-me   # HMAC key shared by Approval Gateway and Booking API only
APPROVAL_TTL_MINUTES=30

# MCP server for external agents (OpenClaw in NVIDIA NemoClaw): enabled only when a token is set.
# NemoClaw registers it with: nemoclaw <sandbox> mcp add reroute --url https://<public-host>/mcp --env REROUTE_MCP_TOKEN
REROUTE_MCP_TOKEN=
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,reroute-api:*   # add your public hostname, e.g. reroute.example.com
PUBLIC_URL=http://localhost:3000

# Remote agent worker (agent in its own sandboxed process)
AGENT_EXECUTION=inline         # inline | remote
AGENT_WORKER_TOKEN=            # required when AGENT_EXECUTION=remote

POSTGRES_PASSWORD=reroute
