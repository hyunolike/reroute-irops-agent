region      = "ap-northeast-2"
environment = "demo"

# GPU host with NVIDIA cuOpt (g6.xlarge = 1x NVIDIA L4). Set false for a cheaper CPU-only demo.
enable_gpu = true

# AWS Free-plan accounts: only free-tier instance types and a short RDS backup retention are allowed
# cpu_instance_type        = "m7i-flex.large"
# db_backup_retention_days = 1

llm_provider       = "auto"   # Nemotron when the NVIDIA key secret is set; otherwise the labelled scripted planner
retriever_provider = "nvidia"
nim_model          = "nvidia/nemotron-3-super-120b-a12b"

image_tag = "latest"

# HTTPS + DNS name - required for the MCP endpoint used by NemoClaw (OpenClaw)
# public_hostname = "reroute.example.com"
# enable_mcp      = true

# Optional HTTPS
# certificate_arn = "arn:aws:acm:ap-northeast-2:123456789012:certificate/..."

# Restrict who can open the demo
# allowed_ingress_cidrs = ["203.0.113.0/24"]

# GitHub Actions deploy (.github/workflows/deploy.yml) - OIDC role, no AWS keys stored in GitHub
# github_repository  = "hyunolike/reroute-irops-agent"
# github_environment = "demo"              # GitHub environment the deploy job uses
# If the deploy fails with "Not authorized to perform sts:AssumeRoleWithWebIdentity", the repo uses immutable
# OIDC subjects - copy the prefix from: gh api repos/<owner>/<repo>/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_sub_claim_prefix = "repo:owner@12345/repo@67890"
# create_github_oidc_provider = false      # if the account already has the GitHub OIDC provider
