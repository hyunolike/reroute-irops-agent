# Rendered by Terraform. Secrets come from /opt/reroute/.env (written at boot from Secrets Manager).
x-logging: &logging
  driver: awslogs
  options:
    awslogs-region: ${region}
    awslogs-group: ${log_group}
    awslogs-create-group: "false"

x-api: &api
  image: ${api_image}
  env_file: .env
  restart: unless-stopped
  logging: *logging

services:
  airline-service:
    <<: *api
    environment:
      APP_ROLE: airline

  reroute-api:
    <<: *api
    environment:
      APP_ROLE: control-plane
    ports: ["8000:8000"]
    depends_on:
      airline-service: { condition: service_healthy }

  web:
    image: ${web_image}
    restart: unless-stopped
    logging: *logging
    ports: ["3000:3000"]
    depends_on:
      reroute-api: { condition: service_healthy }
%{ if enable_gpu ~}

  cuopt:
    image: ${cuopt_image}
    restart: unless-stopped
    logging: *logging
    environment:
      CUOPT_SERVER_PORT: "5000"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
%{ endif ~}
